# Copy this file to .env and fill it in. Never share .env and never put it on GitHub:
# it contains the password of the database.

# The MySQL database (Aiven: "Service URI" on the page of the service)
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/pybac?ssl-mode=REQUIRED

# Optional: path to the CA certificate of Aiven (ca.pem, "CA certificate" on the page of the
# service). With it, the server checks that it really talks to your database.
# DATABASE_CA_CERT=./ca.pem

# Who can see the progress of all the students (comma between emails).
# The admin creates an account on the site with this email, like a student.
ADMIN_EMAILS=you@example.com

# Optional: a code to give to the students. If set, creating an account asks for it,
# so that only your class can sign up.
# SIGNUP_CODE=NSI2026
